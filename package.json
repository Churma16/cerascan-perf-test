{
  "name": "cerascan-perf-test",
  "version": "1.0.0",
  "description": "Comprehensive performance, stress, and load testing suite for CeraScan using Grafana k6",
  "main": "scenarios/01-smoke.test.js",
  "scripts": {
    "test:smoke": "k6 run scenarios/01-smoke.test.js",
    "test:load": "k6 run scenarios/02-average-load.test.js",
    "test:spike": "k6 run scenarios/03-spike-upload.test.js",
    "test:sse": "k6 run scenarios/04-sse-soak.test.js",
    "docker:smoke": "docker run --rm -i -v $(pwd):/app -w /app grafana/k6 run scenarios/01-smoke.test.js",
    "docker:load": "docker run --rm -i -v $(pwd):/app -w /app grafana/k6 run scenarios/02-average-load.test.js",
    "docker:spike": "docker run --rm -i -v $(pwd):/app -w /app grafana/k6 run scenarios/03-spike-upload.test.js",
    "docker:sse": "docker run --rm -i -v $(pwd):/app -w /app grafana/k6 run scenarios/04-sse-soak.test.js",
    "bench:leaderboard": "k6 run scenarios/endpoints/leaderboard-stress.js",
    "bench:dashboard": "k6 run scenarios/endpoints/dashboard-kpi-stress.js",
    "bench:quota": "k6 run scenarios/endpoints/quota-check-stress.js",
    "bench:upload": "k6 run scenarios/endpoints/scan-upload-stress.js",
    "bench:batch": "k6 run scenarios/endpoints/batch-upload-stress.js",
    "bench:insight": "k6 run scenarios/endpoints/model-insight-stress.js",
    "bench:dlq": "k6 run scenarios/endpoints/dlq-stress.js",
    "arch:01": "k6 run scenarios/architecture/01-rabbitmq-async-upload.js",
    "arch:02": "k6 run scenarios/architecture/02-redis-caching-hotspot.js",
    "arch:03": "k6 run scenarios/architecture/03-sse-realtime-stream.js",
    "arch:04": "k6 run scenarios/architecture/04-grpc-ml-inference.js",
    "arch:05": "k6 run scenarios/architecture/05-r2-storage-upload.js",
    "arch:06": "k6 run scenarios/architecture/06-polyglot-mysql-mongo.js",
    "arch:07": "k6 run scenarios/architecture/07-dlq-fault-tolerance.js",
    "arch:08": "k6 run scenarios/architecture/08-batch-multipart-ingest.js",
    "base:01": "k6 run scenarios/baseline/01-rabbitmq-sync-baseline.js",
    "base:02": "k6 run scenarios/baseline/02-redis-nocache-baseline.js",
    "base:03": "k6 run scenarios/baseline/03-sse-polling-baseline.js",
    "base:04": "k6 run scenarios/baseline/04-grpc-rest-baseline.js",
    "base:05": "k6 run scenarios/baseline/05-r2-localdisk-baseline.js",
    "base:06": "k6 run scenarios/baseline/06-cqrs-monolith-baseline.js",
    "base:07": "k6 run scenarios/baseline/07-dlq-failforget-baseline.js",
    "base:08": "k6 run scenarios/baseline/08-batch-loop-baseline.js",
    "docker:bench:leaderboard": "docker run --rm -i -v $(pwd):/app -w /app grafana/k6 run scenarios/endpoints/leaderboard-stress.js",
    "docker:bench:dashboard": "docker run --rm -i -v $(pwd):/app -w /app grafana/k6 run scenarios/endpoints/dashboard-kpi-stress.js",
    "docker:bench:quota": "docker run --rm -i -v $(pwd):/app -w /app grafana/k6 run scenarios/endpoints/quota-check-stress.js",
    "docker:bench:upload": "docker run --rm -i -v $(pwd):/app -w /app grafana/k6 run scenarios/endpoints/scan-upload-stress.js",
    "docker:bench:batch": "docker run --rm -i -v $(pwd):/app -w /app grafana/k6 run scenarios/endpoints/batch-upload-stress.js",
    "docker:bench:insight": "docker run --rm -i -v $(pwd):/app -w /app grafana/k6 run scenarios/endpoints/model-insight-stress.js",
    "docker:bench:dlq": "docker run --rm -i -v $(pwd):/app -w /app grafana/k6 run scenarios/endpoints/dlq-stress.js"
